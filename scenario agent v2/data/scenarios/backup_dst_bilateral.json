          "order": 2
        },
        {
          "option_id": "O3",
          "label": "全球营收 20 亿元且境内营收 2000 万元",
          "order": 3
        }
      ],
      "description": "达到门槛才需登记纳税。门槛越低，覆盖面越广。order 按对中方有利程度排序。"
    },
    {
      "issue_id": "I3",
      "name": "追溯适用期",
      "type": "numeric",
