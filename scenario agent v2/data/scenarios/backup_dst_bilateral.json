          "label": "三年内分步取消",
          "order": 2
        },
        {
          "option_id": "O3",
          "label": "承诺不再新增但与税收进度挂钩",
          "order": 3
        },
        {
          "option_id": "O4",
          "label": "维持现行加征安排",
          "order": 4
        }
      ],
      "description": "order 按对中方有利程度排序，1 最有利。"
    }
  ],
