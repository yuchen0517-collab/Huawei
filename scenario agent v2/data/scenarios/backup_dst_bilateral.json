{
  "scenario_id": "scn-dst-cn-us-0001",
  "title": "中美跨境数字服务税与平台征税安排",
  "scenario_type": "hypothesis",
  "background": "中方已对跨境数字服务实施增值税征管，并要求平台经营者登记纳税；美方长期反对单边数字服务税，曾以 301 调查与加征关税回应欧盟成员国做法。本轮为双边假设推演：双方就税率、征税门槛、追溯期与现有加征关税的去留进行封闭磋商。本场景不对任何现实谈判结果作预测。",
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "假定双方同意把讨论集中在数字服务税与平台征税，不涉及更广泛的市场准入议题。",
      "reason": "议题过宽会退化成零和立场表态，收窄到四项可量化条款才能形成交换。",
      "affects": [
        "I1",
        "I2",
        "I3",
        "I4"
      ]
    },
    {
      "assumption_id": "A2",
      "text": "假定美方愿以逐步取消加征关税，换取中方在税率与门槛上作出明确承诺。",
      "reason": "这是本场景唯一的交换结构；若无此假设，双方只剩相互施压。",
      "affects": [
        "I1",
        "I4"
      ]
    },
    {
      "assumption_id": "A3",
      "text": "本场景为中美双边假设推演，其他国家与多边进程的立场不予建模。",
      "reason": "本轮范围冻结为双边谈判，多边重构不在范围内。",
      "affects": [
        "I1",
        "I4"
      ]
    }
  ],
  "parties": [
    {
      "party_id": "P1",
      "name": "中方（财政部·税务总局）",
      "role_label": "我方",
      "public_position": "主张对跨境数字服务公平征税，税率与门槛应符合本国数字经济发展阶段；反对以单边关税回应税收政策分歧。"
    },
    {
      "party_id": "P2",
      "name": "美方（贸易代表办公室 USTR）",
      "role_label": "对方",
      "public_position": "反对针对本国企业的单边数字服务税，认为其构成歧视性贸易措施；要求税率与门槛不得针对特定国别企业。"
    }
  ],
  "issues": [
    {
      "issue_id": "I1",
      "name": "数字服务税税率",
      "type": "numeric",
      "unit": "%",
      "range": {
        "min": 0,
        "max": 6,
        "step": 0.5
      },
      "options": null,
      "description": "对跨境数字服务营业额适用的税率。0 表示不设单边税。现状按 0 计。"
    },
    {
      "issue_id": "I2",
      "name": "征税门槛",
      "type": "enumerated",
      "unit": null,
      "range": null,
      "options": [
        {
          "option_id": "O1",
          "label": "全球营收 1 亿元且境内营收 200 万元",
          "order": 1
        },
        {
          "option_id": "O2",
