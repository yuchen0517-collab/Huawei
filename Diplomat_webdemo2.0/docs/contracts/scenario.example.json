{
  "scenario_id": "cn-us-chip-export-2026",
  "title": "中美先进制程出口许可磋商",
  "scenario_type": "documented",
  "background": "2026 年初，中美双方在日内瓦举行司局级技术磋商，议题围绕先进制程半导体制造设备的出口许可范围、许可有效期与争端解决渠道展开。此前多轮管制措施使双边设备贸易与维护服务持续承压，双方均表示愿意在国家安全关切与产业利益之间寻找可管理的安排。本轮磋商为闭门会议，谈成结果将作为后续部长级会谈的基础。",
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "双方均把先进制程管制视为国家安全议题，而不是纯商业谈判。",
      "reason": "现有公开表态均以国家安全框架表述，未出现以关税或贸易逆差交换管制的口径。",
      "affects": [
        "export_license_scope",
        "dispute_forum"
      ]
    },
    {
      "assumption_id": "A2",
      "text": "许可有效期可以通过技术性安排延长，且不会立即触发国会审查程序。",
      "reason": "行政部门在逐案许可上保留裁量空间，但需避开已写入法律的硬性限制。",
      "affects": [
        "license_validity_months"
      ]
    }
  ],
  "parties": [
