{
  "scenario_id": "scn_chip_001",
  "title": "中美先进计算芯片出口管制与关键矿产交换",
  "scenario_type": "hypothesis",
  "background": "两国就先进计算芯片的出口许可条件长期僵持。美方以国家安全为由限制高算力芯片对华出口，并对经第三国转口设置审查；中方则以关键矿产（稀土、镓、锗）出口许可作为对等筹码。双方均表示愿意谈，但都不接受先单方面让步。本轮为封闭式双边磋商，议题限定在许可门槛、审批时限、转口限制与关键矿产安排四项。",
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "假定中方国产替代可在两年内部分补足中端算力，使其谈不成时不至于完全被动。",
      "reason": "否则中方 BATNA 过低，会谈在任何报价下都只能接受，失去训练意义。",
      "affects": ["I1"]
    },
    {
      "assumption_id": "A2",
      "text": "假定美方在关键矿产议题上的可接受下限为「民用快速通道 + 终端用途承诺」，即选项 O2。",
      "reason": "现实中美方公开坚持第三方核查（O3），本场景为制造可成交区间而下调其底线，属教学假设。",
      "affects": ["I4"]
    },
    {
      "assumption_id": "A3",
      "text": "本场景为双边简化，只保留中美两个主体，第三方盟友与多边机制的立场不予建模。",
      "reason": "本轮范围冻结为双边谈判，多边重构不在范围内。",
      "affects": ["I3", "I4"]
    }
  ],
  "parties": [
    {
      "party_id": "P1",
      "name": "中方（商务部·工信部）",
      "role_label": "我方",
      "public_position": "反对泛化国家安全概念、滥用出口管制；主张提高可获许可的先进计算芯片算力门槛；主张维持关键矿产出口的现行许可制度，不接受第三方核查。"
    },
    {
      "party_id": "P2",
      "name": "美方（商务部 BIS）",
      "role_label": "对方",
      "public_position": "以国家安全为由管制先进计算半导体，防止先进算力经第三国转口规避管制；关注关键矿产供应的稳定性与终端用途。"
    }
  ],
  "issues": [
    {
      "issue_id": "I1",
      "name": "可获许可的先进计算芯片算力门槛",
      "type": "numeric",
      "unit": "TFLOPS(FP16)",
      "range": { "min": 100, "max": 5000, "step": 100 },
      "options": null,
      "description": "低于该门槛的芯片可获出口许可。数值越高，中方能拿到的芯片越强；美方则希望压低以维持管制效力。现状 800。"
    },
    {
      "issue_id": "I2",
      "name": "许可审批时限",
      "type": "numeric",
      "unit": "天",
      "range": { "min": 15, "max": 180, "step": 15 },
      "options": null,
      "description": "单笔出口许可的法定审批时限上限。天数越短对中方越有利，越长对美方越有利。现状 120 天。"
    },
    {
      "issue_id": "I3",
      "name": "第三国再出口限制",
      "type": "enumerated",
      "unit": null,
      "range": null,
      "options": [
        { "option_id": "O1", "label": "仅需终端用户声明", "order": 1 },
        { "option_id": "O2", "label": "仅对实体清单对象要求许可", "order": 2 },
        { "option_id": "O3", "label": "第三国再出口一律事前许可", "order": 3 },
        { "option_id": "O4", "label": "禁止经第三国转口", "order": 4 }
      ],
