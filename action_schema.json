{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "外交谈判行动",
    "description": "定义一次外交谈判行动的结构。offer_patch 仅在 offer、counter_offer、conditional_exchange、final_offer 行动中允许非空，其余行动类型中必须为空对象。",
    "type": "object",
    "required": [
      "action_id",
      "actor",
      "action_type",
      "card_id",
      "offer_patch",
      "conditions",
      "expected_effect",
      "public_message"
    ],
    "additionalProperties": false,
    "properties": {
      "action_id": {
        "type": "string",
        "description": "行动的唯一编号",
        "minLength": 1
      },
      "actor": {
        "type": "string",
        "description": "行动方，使用国家代码，例如 us、cn",
        "minLength": 1
      },
      "action_type": {
        "type": "string",
        "description": "行动类型",
        "enum": [
          "offer",
          "counter_offer",
          "conditional_exchange",
          "accept",
          "reject",
          "final_offer",
          "walk_away",
          "probe",
          "statement"
        ]
      },
      "card_id": {
        "type": [
          "string",
          "null"
        ],
        "description": "使用的策略卡编号；未使用策略卡时为 null"
      },
      "offer_patch": {
        "type": "object",
        "description": "需要修改的议题条款，键为议题名，值包含 option 和 note",
        "additionalProperties": {
          "type": "object",
          "required": [
            "option",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "option": {
              "type": [
                "string",
                "number"
              ],
              "description": "选项或数值"
            },
            "note": {
              "type": "string",
              "description": "一句话说明"
            }
          }
        }
      },
      "conditions": {
        "type": "array",
        "description": "附加条件；没有附加条件时为空数组",
        "items": {
          "type": "string"
        }
      },
      "expected_effect": {
        "type": "string",
        "description": "一句话说明预计达到的效果"
      },
      "public_message": {
        "type": "string",
        "description": "公开发言全文"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "action_type": {
              "enum": [
                "offer",
                "counter_offer",
                "conditional_exchange",
                "final_offer"
              ]
            }
          },
          "required": [
            "action_type"
          ]
        },
        "else": {
          "properties": {
            "offer_patch": {
              "maxProperties": 0
            }
          }
        }
      }
    ]
  },
  "example": {
    "action_id": "us-counter-offer-0001",
    "actor": "us",
    "action_type": "counter_offer",
    "card_id": null,
    "offer_patch": {
      "全球算力资源分配": {
        "option": "采用附带可核查机制的全球算力资源分配方案",
        "note": "美国提出反报价，并以中国接受可核查机制作为推进算力资源分配安排的交换条件。"
      }
    },
    "conditions": [
      "中国接受可核查机制，对全球算力资源分配方案的落实情况进行核查。"
    ],
    "expected_effect": "推动中国接受可核查机制，为双方就全球算力资源分配方案达成一致创造条件。",
    "public_message": "美国提出反报价：美方愿继续协商全球算力资源分配方案，但中国接受可核查机制是推进这项安排的交换条件。该机制将用于核查双方对既定分配方案的执行情况，以增强安排的透明度和可验证性。"
  }
}