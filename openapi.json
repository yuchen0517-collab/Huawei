                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terminal Type"
          },
          "last_error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AutoErrorResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "status",
          "current_round",
          "terminal_type",
          "last_error"
        ],
        "title": "AutoStatusResponse"
      },
      "AvailableCard": {
