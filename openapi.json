            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "family": {
            "type": "string",
            "title": "Family"
          },
          "quote_board": {
            "type": "boolean",
            "title": "Quote Board"
          },
          "available": {
