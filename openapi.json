  "components": {
    "schemas": {
      "ActionErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorCode"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "engine_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine Error"
          },
          "retry_after": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After"
          },
          "version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "current_state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StateProjection"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error",
          "detail"
        ],
        "title": "ActionErrorResponse"
      },
      "ActionHistoryItem": {
        "properties": {
          "action_id": {
            "type": "string",
            "title": "Action Id"
          },
          "round": {
            "type": "integer",
            "title": "Round"
          },
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "action_type": {
            "type": "string",
            "title": "Action Type"
          },
          "origin": {
            "type": "string",
            "title": "Origin"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "action_id",
          "round",
          "actor",
          "action_type",
          "origin",
          "warnings"
        ],
        "title": "ActionHistoryItem",
        "description": "行动账本项：action_id / round / actor / action_type 是前端证据索引的锚点。"
      },
      "ApiErrorCode": {
        "type": "string",
        "enum": [
          "INVALID_ACTION",
          "ROUND_LOCKED",
          "VERSION_CONFLICT",
          "SESSION_BUSY",
          "MODEL_UNAVAILABLE",
          "TIMEOUT"
        ],
        "title": "ApiErrorCode",
        "description": "行动提交/模型调用对外只出这六个码。"
      },
      "AutoErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "detail"
        ],
        "title": "AutoErrorResponse"
      },
      "AutoStatusResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "paused",
              "done",
              "error"
            ],
            "title": "Status"
          },
          "current_round": {
            "type": "integer",
            "title": "Current Round"
          },
          "terminal_type": {
            "anyOf": [
